  <diagram id="poster_wd_gpr_sr" name="WD-GPR-SR Academic Poster">
    <mxGraphModel dx="2440" dy="1480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1280" math="1" shadow="0">
      <root>
        <mxCell id="0" />
